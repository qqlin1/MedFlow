# 复制为 .env 后按需修改；docker-start.ps1 会在缺失时自动生成一份随机值。
# .env 已在 .gitignore 中，不会进仓库。

# MySQL root 密码（容器内新建的库用的就是它）
MEDFLOW_DB_PASSWORD=change-me-please

# JWT 签名密钥：必须是 Base64 编码的 32 字节随机值
# 生成方式（PowerShell）：
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
MEDFLOW_JWT_SECRET=change-me-please

# 宿主机端口
MEDFLOW_APP_PORT=8080
MEDFLOW_MYSQL_PORT=3307

# 本机 Docker 演示账号：admin / doctor / patient，密码均为 123456
# 应用账号密码与上面的随机数据库密码是两回事；普通非 Docker 启动默认关闭。
MEDFLOW_DEMO_ACCOUNTS_ENABLED=true

# 到期预约后台扫描
MEDFLOW_EXPIRATION_ENABLED=true

# 是否开启 OpenAPI 文档（/swagger-ui/index.html）。对外部署建议 false
MEDFLOW_OPENAPI_ENABLED=true

# JVM 参数
MEDFLOW_JAVA_OPTS=-XX:MaxRAMPercentage=75
# Doctor detail cache; Redis service is internal to Compose.
MEDFLOW_DOCTOR_CACHE_ENABLED=true
MEDFLOW_DEMO_WORKFLOW_ENABLED=true
